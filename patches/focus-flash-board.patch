+/* Reserve a stable adapter number so adding cameras preserves amplifier buses. */
+/ {
+	aliases {
+		i2c0 = &i2c0;
+		i2c1 = &i2c3;
+		i2c2 = &i2c14;
+		i2c3 = &i2c15;
