+/* SoCCP gauge properties used by the OPD2513 stock fg_sm8350_get_* path. */
+static int qcom_battmgr_oplus_gauge_get(struct qcom_battmgr *battmgr,
+				      enum power_supply_property psp,
+				      union power_supply_propval *val)
+{
+	u32 prop, raw;
+	int ret;
+
+	prop = psp == POWER_SUPPLY_PROP_CAPACITY ? OPLUS_CAPACITY : OPLUS_CHARGER_COUNTER;
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_GET, prop, 0);
+	if (ret)
+		goto out;
+	raw = battmgr->oplus.value;
+	if ((psp == POWER_SUPPLY_PROP_CAPACITY && raw > 10000) || (s32)raw < 0) {
+		ret = -ERANGE;
+		goto out;
+	}
+	/* Stock reports centi-percent and microamp-hours, respectively. */
+	if (psp == POWER_SUPPLY_PROP_CAPACITY) {
+		battmgr->status.percent = DIV_ROUND_CLOSEST(raw, 100);
+		val->intval = battmgr->status.percent;
+	} else {
+		battmgr->info.charge_count = raw;
+		val->intval = raw;
+	}
+out:
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
