+static int qcom_battmgr_oplus_bat_status(struct qcom_battmgr *battmgr,
+					union power_supply_propval *val)
+{
+	int ret, status;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+					   BATT_STATUS, 0);
+	if (ret)
+		goto unlock;
+
+	status = battmgr->status.status;
+	if (status == POWER_SUPPLY_STATUS_CHARGING || battmgr->oplus.vooc_buck_held) {
+		/* During AP VOOC, SoCCP reports the disabled buck, not battery flow. */
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+						   BATT_CURR_NOW, 0);
+		if (ret)
+			goto unlock;
+		if (battmgr->status.current_now < 0)
+			status = POWER_SUPPLY_STATUS_DISCHARGING;
+		else if (battmgr->oplus.vooc_buck_held)
+			status = battmgr->status.current_now > 0 ?
+				POWER_SUPPLY_STATUS_CHARGING : POWER_SUPPLY_STATUS_NOT_CHARGING;
+	}
+	val->intval = status;
+
+unlock:
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
