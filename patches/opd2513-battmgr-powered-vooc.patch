+static void qcom_battmgr_oplus_restore_dpdm(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+	struct device *mux;
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	if (!battmgr->oplus_dpdm_claimed)
+		goto out;
+
+	mux = qcom_battmgr_oplus_usbss(battmgr);
+	if (!mux) {
+		dev_warn(battmgr->dev, "USBSS mux is not ready; keeping DPDM claim\n");
+		goto out;
+	}
+
+	ret = wcd939x_usbss_release_handshake(mux, battmgr->dev);
+	put_device(mux);
+	if (ret) {
+		dev_warn(battmgr->dev, "failed to restore USBSS DPDM route: %d\n", ret);
+		goto out;
+	}
+
+	battmgr->oplus_dpdm_claimed = false;
+	dev_info(battmgr->dev, "restored USBSS DPDM route after charger handshake\n");
+out:
+	mutex_unlock(&battmgr->lock);
+}
+
+static void qcom_battmgr_oplus_release_dpdm(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(to_delayed_work(work),
+						   struct qcom_battmgr,
+						   oplus_dpdm_release_work);
+
+	qcom_battmgr_oplus_restore_dpdm(battmgr);
+}
+
+static void qcom_battmgr_oplus_claim_dpdm(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(work, struct qcom_battmgr,
+						   oplus_dpdm_claim_work);
+	struct device *mux;
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	if (!READ_ONCE(battmgr->service_up) || READ_ONCE(battmgr->oplus.otg_state))
+		goto out;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_GET,
+					   OPLUS_USB_TYPE, 0);
+	if (ret)
+		goto out;
+
+	/* Reserve D+/D- for USB until BC1.2 identifies a dedicated charger. */
+	if (battmgr->oplus.value != POWER_SUPPLY_USB_TYPE_DCP) {
+		if (battmgr->oplus_dpdm_claimed)
+			mod_delayed_work(system_dfl_wq, &battmgr->oplus_dpdm_release_work, 0);
+		goto out;
+	}
+
+	if (battmgr->oplus_dpdm_claimed)
+		goto reschedule;
+
+	mux = qcom_battmgr_oplus_usbss(battmgr);
+	if (!mux)
+		goto out;
+
+	ret = wcd939x_usbss_claim_handshake(mux, battmgr->dev);
+	put_device(mux);
+	if (ret) {
+		dev_dbg(battmgr->dev, "USBSS DPDM charger route not claimed: %d\n", ret);
+		goto out;
+	}
+
+	battmgr->oplus_dpdm_claimed = true;
+	dev_info(battmgr->dev, "routed USBSS DPDM to charger for attach handshake\n");
+reschedule:
+	mod_delayed_work(system_dfl_wq, &battmgr->oplus_dpdm_release_work,
+			 msecs_to_jiffies(5000));
+out:
+	mutex_unlock(&battmgr->lock);
+}
+
+/* Caller holds lock: the firmware accepts only one outstanding request. */
+static int qcom_battmgr_oplus_init_charging(struct qcom_battmgr *battmgr)
+{
+	int ret;
+
+	/*
+	 * Match oplus_chg_8350_hardware_init(): firmware may retain an input
+	 * suspend across warm boots. CHG_EN alone only enables the output.
+	 * U32_MAX is the vendor's unsuspend command, not a current request.
+	 * Keep the ordinary USB limit; negotiated higher power is separate.
+	 */
+	/* Stock enables the SoCCP PD policy before it handles charger attach. */
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_SET,
+					  OPLUS_SET_PD_ENABLE, 1);
+	if (ret)
+		return ret;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_GET,
+					  OPLUS_USB_INPUT_CURRENT_LIMIT, 0);
+	if (ret)
+		return ret;
+
+	dev_info(battmgr->dev, "Oplus input limit before init: %u uA\n",
+		 battmgr->oplus.value);
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_SET,
+					  OPLUS_USB_INPUT_CURRENT_LIMIT, U32_MAX);
+	if (ret)
+		return ret;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_SET,
+					  OPLUS_USB_INPUT_CURRENT_LIMIT, 500000);
+	if (ret)
+		return ret;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_SET,
+					  OPLUS_CHG_EN, 1);
+	if (!ret)
+		dev_info(battmgr->dev, "Oplus input unsuspended, 500 mA baseline enabled\n");
+
+	return ret;
+}
