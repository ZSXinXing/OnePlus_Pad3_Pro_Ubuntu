+static int qcom_battmgr_oplus_read(struct qcom_battmgr *battmgr, u32 prop, u32 *value)
+{
+	int ret;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_GET, prop, 0);
+	if (!ret)
+		*value = battmgr->oplus.value;
+	return ret;
+}
+
+static int qcom_battmgr_oplus_buck_read(struct qcom_battmgr *battmgr, u32 prop, u32 *value)
+{
+	int ret;
+
+	if (prop != OPLUS_USB_INPUT_CURRENT_LIMIT)
+		return qcom_battmgr_oplus_read(battmgr, prop, value);
+
+	/* OPD2513 SoCCP accepts the Oplus ICL SET but lacks the vendor GET. */
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+					   USB_INPUT_CURR_LIMIT, 0);
+	if (!ret)
+		*value = battmgr->usb.current_limit;
+	return ret;
+}
+
+static int qcom_battmgr_oplus_write_checked(struct qcom_battmgr *battmgr, u32 prop, u32 value)
+{
+	u32 actual;
+	int ret, attempt;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_SET, prop, value);
+	if (ret) {
+		dev_warn(battmgr->dev, "SuperVOOC buck SET %u=%u failed: %d\n", prop, value, ret);
+		return ret;
+	}
+	/* The remote vote can be applied after the SET acknowledgement. */
+	for (attempt = 0; attempt < 6; attempt++) {
+		if (attempt)
+			msleep(20);
+		ret = qcom_battmgr_oplus_buck_read(battmgr, prop, &actual);
+		if (ret) {
+			dev_warn(battmgr->dev, "SuperVOOC buck GET %u failed: %d\n", prop, ret);
+			return ret;
+		}
+		if (actual == value)
+			return 0;
+	}
+	dev_warn(battmgr->dev, "SuperVOOC buck property %u requested %u, read %u\n",
+		 prop, value, actual);
+	return -EIO;
+}
+
+static int qcom_battmgr_oplus_buck_input_ua(struct qcom_battmgr *battmgr, u32 *ua)
+{
+	int ret;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+					   USB_CURR_NOW, 0);
+	if (!ret)
+		*ua = battmgr->usb.current_now;
+	return ret;
+}
+
+static int qcom_battmgr_oplus_vooc_input_off(struct qcom_battmgr *battmgr)
+{
+	u32 ua = U32_MAX;
+	int ret, i, low = 0;
+
+	/* The ICL GET reports the stored vote. Verify physical input current. */
+	for (i = 0; i < 30; i++) {
+		msleep(50);
+		ret = qcom_battmgr_oplus_buck_input_ua(battmgr, &ua);
+		if (ret)
+			return ret;
+		if (ua > 50000)
+			low = 0;
+		else if (++low == 3) {
+			dev_info(battmgr->dev, "SuperVOOC buck off, USB input %u uA\n", ua);
+			return 0;
+		}
+	}
+	dev_warn(battmgr->dev, "SuperVOOC buck still drawing %u uA\n", ua);
+	return -EIO;
+}
+
+static int qcom_battmgr_oplus_vooc_release(struct qcom_battmgr *battmgr)
+{
+	int ret, unsuspend, restore;
+
+	if (!battmgr->oplus.vooc_buck_held)
+		return 0;
+
+	ret = qcom_battmgr_oplus_write_checked(battmgr, OPLUS_CHG_EN, 1);
+	unsuspend = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_SET,
+						 OPLUS_USB_INPUT_CURRENT_LIMIT, U32_MAX);
+	restore = qcom_battmgr_oplus_write_checked(battmgr, OPLUS_USB_INPUT_CURRENT_LIMIT,
+						  battmgr->oplus.vooc_saved_icl);
+	if (!ret && !unsuspend && !restore)
+		battmgr->oplus.vooc_buck_held = false;
+
+	return ret ?: unsuspend ?: restore;
+}
+
+int qcom_battmgr_oplus_vooc_hold(struct power_supply *psy, bool hold);
+
+int qcom_battmgr_oplus_vooc_hold(struct power_supply *psy, bool hold)
+{
+	struct qcom_battmgr *battmgr;
+	u32 icl, enabled, input_ua;
+	int ret;
+
+	if (psy->desc->get_property != qcom_battmgr_bat_get_property)
+		return -EINVAL;
+	battmgr = power_supply_get_drvdata(psy);
+	if (battmgr->variant != OPLUS_BATTMGR_KAANAPALI)
+		return -EOPNOTSUPP;
+
+	mutex_lock(&battmgr->lock);
+	if (!hold) {
+		ret = qcom_battmgr_oplus_vooc_release(battmgr);
+		goto out;
+	}
+	if (battmgr->oplus.vooc_buck_held || battmgr->info.charge_ctrl_end) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (!READ_ONCE(battmgr->service_up)) {
+		ret = -ENOTCONN;
+		goto out;
+	}
+	ret = qcom_battmgr_oplus_buck_read(battmgr, OPLUS_USB_INPUT_CURRENT_LIMIT, &icl);
+	if (ret)
+		goto out;
+	ret = qcom_battmgr_oplus_read(battmgr, OPLUS_CHG_EN, &enabled);
+	if (ret)
+		goto out;
+	if (!icl || icl > 5000000 || enabled != 1) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	ret = qcom_battmgr_oplus_buck_input_ua(battmgr, &input_ua);
+	if (ret)
+		goto out;
+	if (input_ua < 150000 || input_ua > icl + 50000) {
+		ret = -EAGAIN;
+		goto out;
+	}
+
+	/* A timed-out SET may have taken effect. Keep the snapshot for unwind. */
+	battmgr->oplus.vooc_saved_icl = icl;
+	battmgr->oplus.vooc_buck_held = true;
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_SET,
+					   OPLUS_USB_INPUT_CURRENT_LIMIT, 0);
+	if (!ret)
+		ret = qcom_battmgr_oplus_vooc_input_off(battmgr);
+	if (!ret)
+		ret = qcom_battmgr_oplus_write_checked(battmgr, OPLUS_CHG_EN, 0);
+	if (ret && qcom_battmgr_oplus_vooc_release(battmgr))
+		dev_err(battmgr->dev, "could not restore charging votes after VOOC handoff\n");
+out:
+	mutex_unlock(&battmgr->lock);
+	if (!ret)
+		power_supply_changed(psy);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_battmgr_oplus_vooc_hold);
