+/* Caller holds lock: the firmware accepts only one outstanding request. */
+static struct device *qcom_battmgr_oplus_usbss(struct qcom_battmgr *battmgr)
+{
+	struct device_node *np;
+	struct device *mux;
+
+	np = of_parse_phandle(battmgr->dev->parent->of_node,
+			      "oplus,usbss-mux", 0);
+	if (!np)
+		np = of_find_compatible_node(NULL, NULL, "qcom,wcd9390-usbss");
+	if (!np)
+		return NULL;
+
+	mux = bus_find_device_by_of_node(&i2c_bus_type, np);
+	of_node_put(np);
+	return mux;
+}
