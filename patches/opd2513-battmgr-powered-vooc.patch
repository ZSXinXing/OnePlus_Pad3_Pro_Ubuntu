+static int qcom_battmgr_oplus_usb_type(struct qcom_battmgr *battmgr,
+				      union power_supply_propval *val)
+{
+	int ret;
+	u32 type;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_GET,
+					   OPLUS_USB_TYPE, 0);
+	if (!ret) {
+		type = battmgr->oplus.value;
+		/* The vendor ABI predates the addition of the SPR AVS types. */
+		if (type <= POWER_SUPPLY_USB_TYPE_PD_PPS) {
+			val->intval = type;
+			goto unlock;
+		}
+		if (type == OPLUS_USB_TYPE_BRICK_ID) {
+			val->intval = POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID;
+			goto unlock;
+		}
+	}
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET,
+					   USB_TYPE, 0);
+	if (!ret)
+		val->intval = battmgr->usb.usb_type;
+
+unlock:
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
