+static QUALCOMM_CPU_TEMPERATURE_PATHS: LazyLock<Vec<PathBuf>> = LazyLock::new(|| {
+    if !std::fs::read("/sys/firmware/devicetree/base/compatible").is_ok_and(|data| {
+        data.split(|byte| *byte == 0)
+            .any(|name| name == b"oneplus,opd2513")
+    }) {
+        return Vec::new();
+    }
+    glob("/sys/class/thermal/thermal_zone*/type")
+        .unwrap()
+        .flatten()
+        .filter(|path| {
+            read_parsed::<String>(path).is_ok_and(|kind| {
+                kind.strip_prefix("cpu-")
+                    .is_some_and(|suffix| suffix.starts_with(|c: char| c.is_ascii_digit()))
+            })
+        })
+        .map(|path| path.with_file_name("temp"))
+        .collect()
+});
+
+fn topology_groups(field: &str, expected_cpus: usize) -> Option<usize> {
+    let paths = glob(&format!(
+        "/sys/devices/system/cpu/cpu[0-9]*/topology/{field}"
+    ))
+    .ok()?
+    .collect::<Result<Vec<_>, _>>()
+    .ok()?;
+    if paths.is_empty() || paths.len() != expected_cpus {
+        return None;
+    }
+    paths
+        .into_iter()
+        .try_fold(HashSet::new(), |mut groups, path| {
+            let value = read_parsed::<String>(path).ok()?;
+            if value.is_empty() || value.starts_with('-') {
+                return None;
+            }
+            groups.insert(value);
+            Some(groups)
+        })
+        .map(|groups| groups.len())
+}
+
