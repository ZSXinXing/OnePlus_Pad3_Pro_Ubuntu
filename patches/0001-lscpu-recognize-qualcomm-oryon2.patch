+/* Qualcomm's SMEM SoC ID distinguishes the mobile platform from its
+ * shared CPU MIDR. Only identify a known, live SoC; offline snapshots and
+ * unrecognized devices retain the normal core-name decoding above.
+ */
+static void qcom_soc_decode(struct lscpu_cxt *cxt, struct lscpu_cputype *ct)
+{
+	FILE *file;
+	unsigned int id;
+
+	if (!is_live(cxt) || parse_implementer_id(ct) != 0x51)
+		return;
+	file = fopen("/sys/devices/soc0/soc_id", "re");
+	if (!file)
+		return;
+	if (fscanf(file, "%u", &id) == 1 && id == 661) {
+		free(ct->modelname);
+		ct->modelname = xstrdup("Qualcomm Snapdragon 8 Elite Gen 5 (SM8850P)");
+	}
+	fclose(file);
+}
